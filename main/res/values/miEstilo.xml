<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema de toda la app: hereda del tema por defecto -->
    <style name="miEstilo" parent="Theme.MiAvatar">
        <item name="colorPrimary">@color/primario</item>
        <item name="android:windowBackground">@color/fondo</item>
        <item name="android:textColor">@color/texto</item>
    </style>

    <!-- Estilos para vistas concretas -->
    <style name="estiloTitulo">
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primario</item>
    </style>

    <!-- Hereda de estiloTitulo (por el punto en el nombre) -->
    <style name="estiloTitulo.Nombre">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/secundario</item>
    </style>

    <style name="estiloDato">
        <item name="android:textSize">18sp</item>
    </style>
</resources>